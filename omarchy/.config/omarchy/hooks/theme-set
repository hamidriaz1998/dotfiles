#!/bin/bash

THEME=$1

# Symlink GTK themes if they exist
if [[ -e "~/.config/omarchy/themes/$THEME/gtk.css" ]]; then
  ln -nsf ~/.config/omarchy/themes/$THEME/gtk.css ~/.config/gtk-3.0/gtk.css
  ln -nsf ~/.config/omarchy/themes/$THEME/gtk.css ~/.config/gtk-4.0/gtk.css
fi


SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
THEME_SET_DIR="$SCRIPT_DIR/theme-set.d"

if [[ -d "$THEME_SET_DIR" ]]; then
    for script in "$THEME_SET_DIR"/*; do
        [[ -f "$script" && -x "$script" ]] || continue

        echo "Running: $script"
        "$script"
    done
fi






# >>> omazed hook - do not edit >>>
"/usr/bin/omazed" set "$1"
# <<< omazed hook - do not edit <<<
