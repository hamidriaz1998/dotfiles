#!/usr/bin/env bash

# omarchy:summary=Upload the themed Starship config to the configured VPS hosts

set -u

STARSHIP_CONFIG="${STARSHIP_CONFIG:-$HOME/.config/starship.toml}"
[[ -f "$STARSHIP_CONFIG" ]] || exit 0
command -v scp >/dev/null 2>&1 || exit 0

status=0
pids=()
for host in myvps myvps2 myvps3; do
  timeout 20s scp \
    -q \
    -o BatchMode=yes \
    -o ConnectTimeout=20 \
    "$STARSHIP_CONFIG" \
    "$host:~/.config/starship.toml" &
  pids+=("$!")
done

for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done

exit "$status"
